{
  "name": "immersive-translate-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "test": "vitest run",
    "test:real-sites": "npm run build && node scripts/real-site-regression.mjs --profile=all",
    "test:real-sites:smoke": "npm run build && node scripts/real-site-regression.mjs --profile=smoke",
    "test:real-sites:high-dynamic": "npm run build && node scripts/real-site-regression.mjs --profile=high-dynamic",
    "test:real-sites:long-tail": "npm run build && node scripts/real-site-regression.mjs --profile=long-tail-rules",
    "test:real-sites:fixture-matrix": "npm run build && node scripts/real-site-regression.mjs --profile=fixture-matrix",
    "audit:web-rules": "node scripts/audit-imported-web-rule-capabilities.mjs",
    "audit:rule-semantics": "node scripts/audit-rule-semantics.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "@wxt-dev/storage": "^1.1.0",
    "vue": "^3.5.0",
    "webextension-polyfill": "^0.12.0",
    "wxt": "^0.19.0"
  },
  "overrides": {
    "tar": "7.5.14",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "@vue/test-utils": "^2.4.6",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
